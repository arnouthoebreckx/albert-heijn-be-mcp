{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.arnouthoebreckx/albert-heijn-be-mcp",
  "title": "Albert Heijn",
  "description": "Unofficial Albert Heijn server: products, bonus deals, recipes, shopping list, orders and receipts.",
  "version": "1.3.0",
  "repository": {
    "url": "https://github.com/arnouthoebreckx/albert-heijn-be-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/arnouthoebreckx/albert-heijn-be-mcp#readme",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/arnouthoebreckx/albert-heijn-be-mcp/main/assets/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/arnouthoebreckx/albert-heijn-be-mcp/releases/download/v1.3.0/albert-heijn-be-mcp.mcpb",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/arnouthoebreckx/albert-heijn-be-mcp:1.3.0",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--publish",
          "value": "127.0.0.1:3000:3000"
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:3000/mcp"
      }
    }
  ]
}
