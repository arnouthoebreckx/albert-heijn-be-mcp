# Copy to .env (read from the working directory) and uncomment what you want to change.
# Defaults are shown; variables already set in the environment take precedence.

# MCP HTTP server (streamable-http transport). It listens on 127.0.0.1 only;
# for remote access, put a reverse proxy with TLS in front. Don't expose it over
# plain HTTP (e.g. AH_MCP_HOST=0.0.0.0): the login page sends AH_MCP_TOKEN.
# AH_MCP_HOST=127.0.0.1
# AH_MCP_PORT=3000
# Public URL; OAuth clients are sent here to log in.
# AH_MCP_BASE_URL=http://localhost:3000

# Secret for the HTTP transport, at least 32 characters; it doesn't start
# without it. Entered on the OAuth login page, and used to sign OAuth tokens.
# Changing it logs out every client. Generate one with: openssl rand -hex 32
# AH_MCP_TOKEN=

# Don't open a browser on login; log in by copying the code instead (same as --remote;
# always on with streamable-http).
# AH_REMOTE=false

# Token storage path (default per OS, see "Where your login is stored" in README.md).
# AH_TOKENS_PATH=

# Also append logs to this file (logs always go to stderr).
# AH_LOG_FILE=
