[
  {
    "name": "ah_get_bonus_group_products",
    "annotations": {
      "title": "Albert Heijn: Bonus Group Products",
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "segment_id": {
          "type": "string",
          "description": "Bonus segment ID from the bonus_segment_id field in ah_get_bonus_offers"
        },
        "period": {
          "description": "Bonus week of the offer: 'current' (default); 'next' is an error on ah.be",
          "type": "string",
          "enum": [
            "current",
            "next"
          ]
        },
        "limit": {
          "description": "Maximum number of products to return (default 25, max 100)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "offset": {
          "description": "Number of products to skip, for the next page (default 0)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "include_images": {
          "description": "Include image_url in each product (default false)",
          "type": "boolean"
        }
      },
      "required": [
        "segment_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "period": {
          "type": "string",
          "enum": [
            "current",
            "next"
          ],
          "description": "The bonus week this answer is for"
        },
        "valid_from": {
          "description": "First day of the bonus week (YYYY-MM-DD, inclusive); absent when next week is not published yet",
          "type": "string"
        },
        "valid_until": {
          "description": "Last day of the bonus week (YYYY-MM-DD, inclusive); absent when next week is not published yet",
          "type": "string"
        },
        "total": {
          "type": "number",
          "description": "Products in the group before paging"
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "price": {
                "type": "number",
                "description": "Normal price of one pack in euros, whatever the deal. Same as pack_price."
              },
              "bonus_price": {
                "description": "Price of one pack with the bonus, only where AH sends one: a percentage or euro discount, or a price for one pack ('VOOR 1.99'). Absent for deals on several packs ('2e gratis', '2 voor 5.00'): then deal_min_quantity packs cost deal_total, which is deal_price_per_pack a pack.",
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "is_bonus": {
                "type": "boolean"
              },
              "bonus_mechanism": {
                "type": "string"
              },
              "image_url": {
                "description": "Only with include_images: true",
                "type": "string"
              },
              "pack_price": {
                "description": "Normal shelf price of one pack, in euros",
                "type": [
                  "number",
                  "null"
                ]
              },
              "deal_min_quantity": {
                "description": "Packs needed to get the deal (1 for a plain discount); null without a deal, or when the mechanism is not understood",
                "type": [
                  "number",
                  "null"
                ]
              },
              "deal_total": {
                "description": "What you pay for deal_min_quantity packs with the deal, in euros",
                "type": [
                  "number",
                  "null"
                ]
              },
              "deal_price_per_pack": {
                "description": "deal_total / deal_min_quantity, in euros",
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit_price": {
                "description": "Normal price per unit_price_unit, where AH gives one",
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit_price_unit": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "kg",
                      "l",
                      "stuk"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The unit of unit_price"
              },
              "category": {
                "type": "string",
                "description": "The bonus category of the group, as in ah_get_bonus_offers"
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "price",
              "is_bonus",
              "pack_price",
              "deal_min_quantity",
              "deal_total",
              "deal_price_per_pack",
              "unit_price",
              "unit_price_unit",
              "category"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "period",
        "total",
        "products"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    }
  },
  {
    "name": "ah_get_bonus_offers",
    "annotations": {
      "title": "Albert Heijn: Bonus Offers",
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "description": "Maximum number of results to return (default 20)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "query": {
          "description": "Optional keyword filter (Dutch or English) applied client-side, e.g. 'kaas', 'vlees', 'bier'",
          "type": "string"
        },
        "period": {
          "description": "Which bonus week to return: 'current' (default) or 'next'",
          "type": "string",
          "enum": [
            "current",
            "next"
          ]
        },
        "previously_bought": {
          "description": "Only offers on products the user bought before",
          "type": "boolean"
        },
        "categories": {
          "description": "Only offers in these bonus categories, by name as in the categories of the answer (case does not matter; an unknown name is an error)",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "food_only": {
          "description": "Leave out exactly AH's non-food categories ('Huishouden', 'Drogisterij', 'Koken, tafelen, vrije tijd'); every other category stays, such as 'Baby en kind' and 'Gezondheid en sport' (default false). With categories, only the food ones of them come back",
          "type": "boolean"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "period": {
          "type": "string",
          "enum": [
            "current",
            "next"
          ],
          "description": "The bonus week this answer is for"
        },
        "valid_from": {
          "description": "First day of the bonus week (YYYY-MM-DD, inclusive); absent when next week is not published yet",
          "type": "string"
        },
        "valid_until": {
          "description": "Last day of the bonus week (YYYY-MM-DD, inclusive); absent when next week is not published yet",
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "offer_count": {
                "type": "number",
                "description": "Offers in this category over the whole week, before any filter"
              }
            },
            "required": [
              "name",
              "offer_count"
            ],
            "additionalProperties": false
          },
          "description": "Every bonus category of the week with its number of offers, before any filter"
        },
        "total": {
          "type": "number",
          "description": "Number of offers that match period, query, categories, food_only and previously_bought, before limit: offers holds at most limit of them. Ask again with limit = total to get all"
        },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "bonus_segment_id": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "description": "For a group offer (bonus_segment_id set) AH's name for the group, not the title of one member: ah_get_bonus_group_products lists the members"
              },
              "url": {
                "type": "string"
              },
              "category": {
                "description": "The ah.be bonus category of the offer, as in the categories of the answer",
                "type": "string"
              },
              "original_price": {
                "description": "Regular price as AH sends it, for the packs the deal needs (deal_min_quantity packs, e.g. two bags for '2e gratis'), not for one pack: pack_price is one pack. A group offer has no product of its own: this is AH's example product of the group.",
                "type": "number"
              },
              "bonus_price": {
                "description": "Price of those packs with the deal, as AH sends it (deal_total for deal_min_quantity packs). Absent for deals like '2 voor 1.19'. A group offer has no product of its own: this is AH's example product of the group.",
                "type": "number"
              },
              "discount_percentage": {
                "type": "number"
              },
              "bonus_mechanism": {
                "type": "string"
              },
              "valid_from": {
                "description": "Only when this offer starts on another day than the week (YYYY-MM-DD)",
                "type": "string"
              },
              "valid_until": {
                "description": "Only when this offer ends on another day than the week (YYYY-MM-DD)",
                "type": "string"
              },
              "pack_price": {
                "description": "Normal shelf price of one pack, in euros. For a group offer (bonus_segment_id set) this is one member's: ah_get_bonus_group_products has each member's.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "deal_min_quantity": {
                "description": "Packs needed to get the deal (1 for a plain discount); null without a deal, or when the mechanism is not understood. For a group offer (bonus_segment_id set) this is one member's: ah_get_bonus_group_products has each member's.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "deal_total": {
                "description": "What you pay for deal_min_quantity packs with the deal, in euros. For a group offer (bonus_segment_id set) this is one member's: ah_get_bonus_group_products has each member's.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "deal_price_per_pack": {
                "description": "deal_total / deal_min_quantity, in euros. For a group offer (bonus_segment_id set) this is one member's: ah_get_bonus_group_products has each member's.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit_price": {
                "description": "Normal price per unit_price_unit, where AH gives one",
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit_price_unit": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "kg",
                      "l",
                      "stuk"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The unit of unit_price"
              }
            },
            "required": [
              "title",
              "pack_price",
              "deal_min_quantity",
              "deal_total",
              "deal_price_per_pack",
              "unit_price",
              "unit_price_unit"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "period",
        "categories",
        "total",
        "offers"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    }
  },
