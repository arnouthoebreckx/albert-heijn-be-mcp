  {
    "name": "ah_get_products",
    "annotations": {
      "title": "Albert Heijn: Product Details",
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "product_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "description": "Product IDs from ah_search_products, e.g. [123456] or [123456, 789012] (max 20)"
        },
        "include_nutritional_info": {
          "description": "Include nutritional values (default false)",
          "type": "boolean"
        }
      },
      "required": [
        "product_ids"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number"
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "brand": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "price": {
                    "type": "number"
                  },
                  "bonus_price": {
                    "type": "number"
                  },
                  "unit_size": {
                    "type": "string"
                  },
                  "unit_price_description": {
                    "type": "string"
                  },
                  "is_bonus": {
                    "type": "boolean"
                  },
                  "bonus_mechanism": {
                    "type": "string"
                  },
                  "nutri_score": {
                    "type": "string"
                  },
                  "is_available": {
                    "type": "boolean"
                  },
                  "property_icons": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "nutritional_info": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "name",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "image_url": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "url",
                  "price",
                  "is_bonus",
                  "is_available"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "error"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "products"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    }
  },
