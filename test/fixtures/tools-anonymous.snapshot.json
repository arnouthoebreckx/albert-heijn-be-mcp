[
  {
    "name": "ah_get_bonus_group_products",
    "annotations": {
      "title": "Albert Heijn: Bonus Group Products",
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "segment_id": {
          "type": "string",
          "description": "Bonus segment ID from the bonus_segment_id field in ah_get_bonus_offers"
        },
        "period": {
          "description": "Bonus week of the offer: 'current' (default) or 'next'",
          "type": "string",
          "enum": [
            "current",
            "next"
          ]
        }
      },
      "required": [
        "segment_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "bonus_price": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "is_bonus": {
                "type": "boolean"
              },
              "bonus_mechanism": {
                "type": "string"
              },
              "image_url": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "price",
              "is_bonus"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "products"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    }
  },
  {
    "name": "ah_get_bonus_offers",
    "annotations": {
      "title": "Albert Heijn: Bonus Offers",
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "description": "Maximum number of results to return (default 20)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "query": {
          "description": "Optional keyword filter (Dutch or English) applied client-side, e.g. 'kaas', 'vlees', 'bier'",
          "type": "string"
        },
        "period": {
          "description": "Which bonus week to return: 'current' (default) or 'next'",
          "type": "string",
          "enum": [
            "current",
            "next"
          ]
        },
        "previously_bought": {
          "description": "Only offers on products the user bought before",
          "type": "boolean"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "bonus_segment_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "original_price": {
                "type": "number"
              },
              "bonus_price": {
                "type": "number"
              },
              "discount_percentage": {
                "type": "number"
              },
              "bonus_mechanism": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "offers"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    }
  },
