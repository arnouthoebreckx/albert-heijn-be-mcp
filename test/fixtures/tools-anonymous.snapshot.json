  {
    "name": "ah_search_products",
    "annotations": {
      "title": "Albert Heijn: Search Products",
      "readOnlyHint": true
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Search queries in Dutch or English, e.g. [\"melk\"] or [\"melk\", \"kaas\", \"brood\"] (max 10)"
        },
        "limit": {
          "description": "Maximum results per query (default 10 for one query, 5 for several; max 30)",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "bonus": {
          "description": "Return only products currently on bonus/promotion",
          "type": "boolean"
        },
        "filters": {
          "description": "Only products matching all of these, e.g. [\"organic\", \"vegan\"]",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "organic",
              "prijsfavoriet",
              "new",
              "frozen",
              "vegan",
              "vegetarian",
              "low_sugar",
              "low_fat",
              "low_salt",
              "gluten_free",
              "lactose_free",
              "milk_free",
              "egg_free",
              "nut_free",
              "peanut_free",
              "soy_free",
              "fish_free",
              "shellfish_free",
              "sesame_free",
              "celery_free",
              "mustard_free",
              "lupin_free",
              "sulphite_free"
            ]
          }
        },
        "sort": {
          "description": "Result order (default relevance)",
          "type": "string",
          "enum": [
            "relevance",
            "price_low_high",
            "price_high_low",
            "most_bought",
            "nutriscore"
          ]
        }
      },
      "required": [
        "queries"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "searches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "price": {
                      "type": "number"
                    },
                    "bonus_price": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "is_bonus": {
                      "type": "boolean"
                    },
                    "bonus_mechanism": {
                      "type": "string"
                    },
                    "image_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "url",
                    "price",
                    "is_bonus"
                  ],
                  "additionalProperties": false
                }
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "query",
              "results"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "searches"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    }
  },
  {
    "name": "ah_search_recipes",
