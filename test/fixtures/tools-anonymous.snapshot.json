      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number"
        },
        "recipes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "cook_minutes": {
                "type": "number"
              },
              "oven_minutes": {
                "type": "number"
              },
              "wait_minutes": {
                "type": "number"
              },
              "servings": {
                "type": "string"
              },
              "courses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nutri_score": {
                "type": "string"
              },
              "rating": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "total",
        "recipes"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    }
  }
]
