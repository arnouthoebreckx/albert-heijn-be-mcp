[Unit]
Description=Albert Heijn MCP Server
After=network-online.target
Wants=network-online.target

[Service]
User=albert-heijn-mcp
EnvironmentFile=/home/albert-heijn-mcp/.env
ExecStart=/usr/local/bin/albert-heijn-mcp --transport streamable-http --remote
WorkingDirectory=/home/albert-heijn-mcp
Restart=on-failure
RestartSec=5

# Hardening: the server needs only the network and write access to its home
# directory (tokens live in /home/albert-heijn-mcp/.config). If AH_LOG_FILE points
# elsewhere, add it to ReadWritePaths. MemoryDenyWriteExecute is left out:
# Node's JIT compiler needs it off.
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ReadWritePaths=/home/albert-heijn-mcp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
